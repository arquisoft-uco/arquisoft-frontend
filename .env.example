# Copia este archivo como .env.development.local y completa los valores reales.
# NUNCA hagas commit de .env.development.local ni .env.production.local.
#
# En producción (GitHub Actions → GHCR → Oracle Cloud), el contenido de este
# archivo (con los valores reales, sin las líneas de bypass) vive en UN solo
# secreto del repo: VITE_ENV_FILE. docker-build.yml lo escribe como
# .env.production.local antes del build; Vite lo carga solo y embebe las
# VITE_* en el bundle. El contenedor nginx que las sirve no necesita ningún
# archivo .env en runtime.

# ── API ────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api

# ── Keycloak ───────────────────────────────────────────────────────────────────
VITE_KEYCLOAK_URL=http://localhost:8081/
VITE_KEYCLOAK_REALM=your-realm
VITE_KEYCLOAK_CLIENT_ID=your-client-id

# ── Security Baseline (PDP/BFF) y Security UI ──────────────────────────────────
# Opcionales; las tres van juntas. Sin ellas solo está disponible Keycloak.
VITE_PDP_URL=http://localhost:18080
VITE_SECURITY_UI_URL=http://localhost:5175/security-administration.js
VITE_APPLICATION_NAME=arquisoft-frontend

# ── Dev bypass (solo para desarrollo local) ────────────────────────────────────
# Cambia a false para probar el flujo real de Keycloak.
VITE_AUTH_BYPASS=true
VITE_DEV_USERNAME=dev-user
# Roles separados por coma. Deben coincidir con los roles de realm de Keycloak y con el enum Rol
# (con guion: asesor-ficha, representante-comite).
VITE_DEV_ROLES=estudiante,asesor-ficha,coordinador,representante-comite,asesor,jurado,administrador,bibliotecario
